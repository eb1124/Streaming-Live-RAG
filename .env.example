# Copy to .env (git-ignored) and fill in. Never commit real keys.
# Variables already set in your shell take precedence over this file.
GROQ_API_KEY=
# Phase 9 (optional): PostgreSQL for the MCP database_query tool; see docs/database.md. Set it in the shell:
# services.persistence and services.mcp read the environment, not this file.
# DATABASE_URL=postgresql://<user>:<password>@127.0.0.1:5433/adaptiverag
# Phase 10A (optional): tracing; see docs/telemetry.md. Off by default; set in the shell, not in this file.
# OTEL_TRACES_EXPORTER=console
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
